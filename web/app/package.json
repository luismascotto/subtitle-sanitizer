{
  "name": "subtitle-sanitizer-app",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor mobile shell for subtitle-sanitizer WASM",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:all": "npm run build:wasm && npm run build",
    "cap:sync": "npm run build:all && cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "preview": "vite preview",
    "serve": "npm run build:all && vite preview"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "vite": "^7.3.7"
  }
}
